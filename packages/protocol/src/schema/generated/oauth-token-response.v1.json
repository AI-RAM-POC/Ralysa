{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ralysa:schema:oauth-token-response.v1",
  "title": "TokenResponse",
  "type": "object",
  "properties": {
    "access_token": {
      "type": "string"
    },
    "token_type": {
      "type": "string",
      "const": "Bearer"
    },
    "expires_in": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "refresh_token": {
      "type": "string"
    },
    "issued_token_type": {
      "type": "string"
    }
  },
  "required": [
    "access_token",
    "token_type",
    "expires_in"
  ],
  "additionalProperties": false
}
