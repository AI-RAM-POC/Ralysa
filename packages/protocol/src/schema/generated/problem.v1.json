{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ralysa:schema:problem.v1",
  "title": "Problem",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^urn:ralysa:problem:[a-z_]+$"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "detail": {
      "type": "string",
      "maxLength": 1000
    },
    "instance": {
      "type": "string",
      "maxLength": 200
    },
    "code": {
      "type": "string",
      "enum": [
        "invalid_request",
        "unauthorized",
        "forbidden",
        "not_found",
        "conflict",
        "locked",
        "payload_too_large",
        "unprocessable",
        "rate_limited",
        "audit_unavailable",
        "temporarily_unavailable",
        "internal"
      ]
    },
    "i18n_key": {
      "type": "string",
      "maxLength": 100
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  },
  "required": [
    "type",
    "title",
    "status",
    "code"
  ],
  "additionalProperties": {}
}
