{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ralysa:schema:oauth-revoke-request.v1",
  "title": "RevokeRequest",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "const": "ralysa-cli"
    },
    "token": {
      "type": "string",
      "maxLength": 128
    },
    "token_type_hint": {
      "type": "string",
      "const": "refresh_token"
    }
  },
  "required": [
    "client_id",
    "token"
  ],
  "additionalProperties": false
}
