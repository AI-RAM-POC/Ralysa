{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ralysa:schema:audit-client-events-unavailable.v1",
  "title": "ClientEventsUnavailable",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^urn:ralysa:problem:[a-z_]+$"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "detail": {
      "type": "string",
      "maxLength": 1000
    },
    "instance": {
      "type": "string",
      "maxLength": 200
    },
    "code": {
      "type": "string",
      "enum": [
        "invalid_request",
        "unauthorized",
        "forbidden",
        "not_found",
        "conflict",
        "locked",
        "payload_too_large",
        "unprocessable",
        "rate_limited",
        "audit_unavailable",
        "temporarily_unavailable",
        "internal"
      ]
    },
    "i18n_key": {
      "type": "string",
      "maxLength": 100
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "acks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "ack": {
            "type": "boolean"
          },
          "governance": {
            "type": "object",
            "properties": {
              "epoch": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "halted": {
                "type": "boolean"
              },
              "reason_category": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "epoch",
              "halted",
              "reason_category"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "event_id",
          "ack",
          "governance"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "type",
    "title",
    "status",
    "code",
    "acks"
  ],
  "additionalProperties": {}
}
