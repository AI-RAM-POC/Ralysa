{
  "name": "@ralysa/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared zod contracts: common primitives, audit envelope, token claims, control-plane REST types (F-002); Agent Protocol (F-003).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "default": "./dist/common/index.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "default": "./dist/audit/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./control-plane": {
      "types": "./dist/control-plane/index.d.ts",
      "default": "./dist/control-plane/index.js"
    },
    "./schema/*.json": "./src/schema/generated/*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:generated": "tsc -p tsconfig.build.json && node scripts/generate-schemas.js",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "canonicalize": "4.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ralysa/eslint-config": "workspace:*",
    "@ralysa/tsconfig": "workspace:*",
    "@ralysa/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "ralysa": {
    "kind": "library",
    "runtime": "isomorphic",
    "shipped": false,
    "ui": false
  }
}
