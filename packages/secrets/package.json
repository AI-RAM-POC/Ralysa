{
  "name": "@ralysa/secrets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@ralysa/dev-stack": "workspace:*",
    "@ralysa/eslint-config": "workspace:*",
    "@ralysa/tsconfig": "workspace:*",
    "@ralysa/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jose": "6.2.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "ralysa": {
    "kind": "library",
    "runtime": "isomorphic",
    "shipped": false,
    "ui": false
  },
  "description": "SecretStore and KeyCustody ports, OpenBao KV v2 and Transit adapters, in-memory doubles (F-002)."
