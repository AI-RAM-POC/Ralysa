{
  "name": "@ralysa/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/css/tokens.css",
    "./theme.css": "./src/styles/theme.css",
    "./tailwind.css": "./src/styles/tailwind.css"
  },
  "scripts": {
    "build": "node scripts/build-tokens.ts && tsc -p tsconfig.build.json",
    "check:generated": "node scripts/build-tokens.ts",
    "lint": "eslint . && stylelint \"**/*.css\" --allow-empty-input",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@ralysa/eslint-config": "workspace:*",
    "@ralysa/repo-scripts": "workspace:*",
    "@ralysa/stylelint-config": "workspace:*",
    "@ralysa/tsconfig": "workspace:*",
    "@ralysa/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "stylelint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "ralysa": {
    "kind": "library",
    "runtime": "browser",
    "shipped": false,
    "ui": true
  }
}
