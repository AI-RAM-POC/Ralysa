{
  "name": "@ralysa/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./examples": {
      "types": "./dist/examples/index.d.ts",
      "default": "./dist/examples/index.js"
    },
    "./tokens.css": "./dist/css/tokens.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./theme.css": "./src/styles/theme.css",
    "./tailwind.css": "./src/styles/tailwind.css",
    "./font-licenses": "./scripts/font-licenses.ts",
    "./font-coverage": "./scripts/font-coverage.ts"
  },
  "scripts": {
    "build": "node scripts/build-tokens.ts && node scripts/font-licenses.ts && tsc -p tsconfig.build.json",
    "check:generated": "node scripts/build-tokens.ts && i18next-cli types --quiet",
    "lint": "eslint . && stylelint \"**/*.css\" --allow-empty-input && i18next-cli extract --ci --dry-run --quiet",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@fontsource-variable/noto-sans-mono": "5.3.0",
    "@radix-ui/react-direction": "catalog:",
    "i18next": "catalog:",
    "lucide-react": "1.34.0",
    "radix-ui": "catalog:",
    "react-i18next": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@ralysa/eslint-config": "workspace:*",
    "@ralysa/repo-scripts": "workspace:*",
    "@ralysa/stylelint-config": "workspace:*",
    "@ralysa/tsconfig": "workspace:*",
    "@ralysa/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "i18next-cli": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "stylelint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "ralysa": {
    "kind": "library",
    "runtime": "browser",
    "shipped": false,
    "ui": true
  }
}
