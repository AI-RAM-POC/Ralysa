{
  "extends": "@ralysa/tsconfig/react-lib.json",
  "compilerOptions": {
    // scripts/ and the Node-side tests run on Node 24 type stripping and import .ts files directly.
    // tsconfig.build.json switches both options back off, so shipped src/ can't use Node types.
    "types": ["node"],
    "allowImportingTsExtensions": true,
    // Referenceable library convention (repo-conventions.md): a referenced project may not
    // disable emit (TS6310), so the typecheck config emits declarations only, into the
    // git-ignored .tsc/. The real build is tsconfig.build.json → dist/.
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "${configDir}/.tsc"
  },
  "include": ["src", "src/locales/*/*.json", "test", "scripts", "*.config.ts"]
}
