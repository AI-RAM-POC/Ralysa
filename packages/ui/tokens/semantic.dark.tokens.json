{
  "$description": "Ralysa semantic tokens, dark theme (DTCG Format 2025.10). Aliases into core.tokens.json. Every pair used for text or UI boundaries is in contrast-pairs.json.",
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "{palette.gray.950}"
      },
      "surface": {
        "$value": "{palette.gray.925}"
      },
      "subtle": {
        "$value": "{palette.gray.850}"
      }
    },
    "fg": {
      "default": {
        "$value": "{palette.gray.100}"
      },
      "muted": {
        "$value": "{palette.gray.300}"
      },
      "onAccent": {
        "$value": "{palette.blue.950}"
      },
      "disabled": {
        "$value": "{palette.gray.400}",
        "$description": "Inactive controls only: exempt from WCAG 1.4.3 (see contrast-pairs.json)."
      }
    },
    "accent": {
      "default": {
        "$value": "{palette.blue.300}"
      },
      "hover": {
        "$value": "{palette.blue.200}"
      }
    },
    "border": {
      "decor": {
        "$value": "{palette.gray.800}",
        "$description": "Decorative only; never the sole boundary of a control."
      },
      "control": {
        "$value": "{palette.gray.450}",
        "$description": "Boundary of an input or control (WCAG 1.4.11)."
      }
    },
    "focus": {
      "ring": {
        "$value": "{palette.blue.300}"
      }
    },
    "link": {
      "$value": "{palette.blue.250}"
    },
    "status": {
      "danger": {
        "$value": "{palette.red.300}"
      },
      "success": {
        "$value": "{palette.green.300}"
      },
      "warning": {
        "$value": "{palette.amber.300}"
      }
    }
  },
  "elevation": {
    "shadow": {
      "$type": "shadow",
      "sm": {
        "$value": {
          "color": "{palette.shadow.dark}",
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 1, "unit": "px" },
          "blur": { "value": 2, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      },
      "md": {
        "$value": {
          "color": "{palette.shadow.dark}",
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 4, "unit": "px" },
          "blur": { "value": 8, "unit": "px" },
          "spread": { "value": -2, "unit": "px" }
        }
      },
      "lg": {
        "$value": {
          "color": "{palette.shadow.dark}",
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 12, "unit": "px" },
          "blur": { "value": 24, "unit": "px" },
          "spread": { "value": -4, "unit": "px" }
        }
      }
    }
  }
}
