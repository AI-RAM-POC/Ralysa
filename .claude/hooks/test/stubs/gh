#!/usr/bin/env node
// A stand-in for the gh CLI in the guard-bash fixture tests. It answers `gh pr view` and
// `gh pr checks` from the JSON file named by GUARD_TEST_GH_FILE, and fails for anything else,
// so a test can never reach the real gh or GitHub.
import { readFileSync } from 'node:fs';

const file = process.env.GUARD_TEST_GH_FILE;
const [group, verb] = process.argv.slice(2);
if (!file) {
  process.stderr.write('gh stub: no GUARD_TEST_GH_FILE for this fixture\n');
  process.exit(4);
}
const canned = JSON.parse(readFileSync(file, 'utf8'));
if (group === 'pr' && verb === 'view') {
  process.stdout.write(`${JSON.stringify(canned.pr)}\n`);
  process.exit(0);
}
if (group === 'pr' && verb === 'checks') {
  process.stdout.write(`${JSON.stringify(canned.checks)}\n`);
  // Like gh: exit 8 while a check is pending, 1 when one failed.
  if (canned.checks.some((c) => c.bucket === 'pending')) process.exit(8);
  if (canned.checks.some((c) => c.bucket === 'fail')) process.exit(1);
  process.exit(0);
}
process.stderr.write(`gh stub: unexpected call gh ${process.argv.slice(2).join(' ')}\n`);
process.exit(4);
