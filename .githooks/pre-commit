#!/bin/sh
# Git pre-commit hook (F-001 design §6.2.4; SEC-F001-07): scans the staged changes for secrets
# with the hash-pinned gitleaks. Enable it once per clone with `pnpm hooks:install`
# (git config core.hooksPath .githooks). CI's secret-scan job stays the backstop.
set -eu
top=$(git rev-parse --show-toplevel)
exec sh "$top/tooling/repo-scripts/bin/gitleaks-staged.sh"
