{
  "name": "@ralysa/eslint-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared ESLint flat-config presets (base, isomorphic, react-ui, tests) and the boundary lists.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./index.js"
    },
    "./boundaries": {
      "types": "./dist/boundaries.d.ts",
      "default": "./boundaries.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.20.5",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "typescript-eslint": "8.70.1"
  },
  "peerDependencies": {
    "eslint": "^10.11.0",
    "typescript": ">=6.0.3 <6.1.0"
  },
  "devDependencies": {
    "@ralysa/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "ralysa": {
    "kind": "tooling",
    "shipped": false,
    "ui": false,
    "artefacts": []
  }
}
