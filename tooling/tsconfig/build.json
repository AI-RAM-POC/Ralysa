{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Ralysa emit settings: extend this from a workspace's tsconfig.build.json (src/ only, to dist/)",
  "compilerOptions": {
    "noEmit": false,
    "composite": false,
    "incremental": false,
    "rootDir": "${configDir}/src",
    "outDir": "${configDir}/dist"
  },
  "include": ["${configDir}/src"]
}
