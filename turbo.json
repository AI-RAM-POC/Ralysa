{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    ".dependency-cruiser.cjs",
    "tsconfig.json",
    "prettier.config.js",
    ".prettierignore",
    ".nvmrc",
    "pnpm-workspace.yaml",
    "tooling/**/*",
    "!tooling/**/node_modules/**",
    "!tooling/**/.turbo/**",
    "!tooling/**/dist/**"
  ],
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": [".tsc/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["RALYSA_REQUIRE_DEV_STACK"]
    },
    "check:generated": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
